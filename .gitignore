bin/
.gc/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Gas City
.beads/*
!.beads/identity.toml
/.pi

# bv (b9s) local config and caches
.bv/

# Per-bead worktrees (gc staged workflow)
/worktrees/

# Workflow scratch: plans/ holds per-attempt output (summaries, reviews,
# decompositions). The durable record is the bead plus git history; only the
# marker file is tracked.
/plans/*
!/plans/.gc-plans
